      "type": "pump",
      "description": "Raw water intake pump",
      "coordinates": {"x": 1.5, "y": 5.0},
      "safe_range": {"min": 0, "max": 1},
      "unit": "on/off",
      "affects": ["pipe_P1_T101", "tank_T101"],
      "failure_consequence": "No raw water intake — plant starved",
      "attack_effect": "Flood intake if left running with closed outlet",
      "time_to_failure_seconds": 120,
      "severity": "MEDIUM",
      "remediation": "Close V1 inlet valve at (0.5, 5.0)"
    },
    "40002": {
      "component": "Tank T101 Level",
      "stage": "P1",
      "type": "sensor",
      "description": "Raw water storage tank level sensor",
      "coordinates": {"x": 3.0, "y": 5.0},
      "safe_range": {"min": 500, "max": 800},
      "unit": "mm",
      "affects": ["pump_P101", "valve_MV101"],
      "failure_consequence": "Overflow or dry run condition",
      "attack_effect": "Spoof level reading — pump runs dry or tank overflows",
      "time_to_failure_seconds": 90,
      "severity": "HIGH",
      "remediation": "Manual level inspection at T101 (3.0m, 5.0m)"
