      "time_to_failure_seconds": 23,
      "severity": "CATASTROPHIC",
      "remediation": "Close emergency valve EV2 at (6.1m, 4.5m) IMMEDIATELY"
    },
    "40004": {
      "component": "Pump P205",
      "stage": "P2",
      "type": "chemical_pump",
      "description": "Chemical dosing injection pump",
