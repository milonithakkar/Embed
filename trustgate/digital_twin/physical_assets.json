  "attack_scenarios": {
    "oldsmar_replay": {
      "name": "Oldsmar 2021 Replay",
      "sequence": ["40003", "40004"],
      "description": "Chemical overdose attack matching 2021 Florida incident",
      "target_registers": ["40003"],
      "dangerous_value": 9999,
      "detection_window_seconds": 23
    },
    "pressure_attack": {
      "name": "RO Pipe Rupture Attack",
      "sequence": ["40007", "40008"],
      "description": "Close relief valve then run high-pressure pump",
      "target_registers": ["40007", "40008"],
      "dangerous_value": 0,
      "detection_window_seconds": 8
    },
    "stealthy_drain": {
      "name": "Slow Tank Drain",
      "sequence": ["40009"],
      "description": "Gradual sensor spoofing — below rule-based detection threshold",
      "target_registers": ["40009"],
      "dangerous_value": 1,
      "detection_window_seconds": 180
    }
  },

  "pipe_connections": [
    {"id": "pipe_P1_T101",         "from": "40001", "to": "40002", "path": [[1.5,5.0],[3.0,5.0]]},
