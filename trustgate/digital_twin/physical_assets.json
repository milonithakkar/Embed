      "coordinates": {"x": 6.1, "y": 4.5},
      "safe_range": {"min": 1, "max": 1},
      "unit": "on/off",
      "affects": ["valve_MV201", "pump_P205", "pipe_P2_chemical"],
      "failure_consequence": "Chemical stage isolated — plant halts but safe",
      "attack_effect": "Force-close EV2 during normal ops — chemical starvation",
      "time_to_failure_seconds": 300,
      "severity": "LOW",
      "remediation": "This IS a remediation valve — closing it stops chemical attacks"
    }
