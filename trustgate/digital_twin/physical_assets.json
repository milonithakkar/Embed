      "coordinates": {"x": 11.0, "y": 5.0},
      "safe_range": {"min": 0, "max": 1},
      "unit": "on/off",
      "affects": ["pipe_P5_high_pressure", "valve_PRV1"],
      "failure_consequence": "Pressure buildup — pipe rupture",
      "attack_effect": "Run P501 with PRV1 closed — 8 seconds to rupture",
      "time_to_failure_seconds": 8,
      "severity": "CRITICAL",
      "remediation": "Emergency stop P501 immediately, open PRV1"
    },
    "40009": {
      "component": "Tank T601 Level",
      "stage": "P6",
      "type": "sensor",
      "description": "Permeate (clean water) storage tank",
      "coordinates": {"x": 13.0, "y": 5.0},
      "safe_range": {"min": 500, "max": 1000},
      "unit": "mm",
      "affects": ["pump_P602", "distribution_main"],
      "failure_consequence": "No clean water supply to consumers",
      "attack_effect": "Drain tank while spoofing full reading — distribution failure",
      "time_to_failure_seconds": 180,
      "severity": "MEDIUM",
      "remediation": "Open bypass valve BV601 at (13.5m, 3.5m)"
